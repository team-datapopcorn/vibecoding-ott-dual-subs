{
  "manifest_version": 3,
  "name": "OTT 이중자막 (Dual Subs)",
  "version": "2.0.0",
  "description": "쿠팡플레이·넷플릭스에서 한국어+영어 자막을 동시에 표시합니다. 영어 공부에 최적화된 이중자막 익스텐션.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.coupangstreaming.com/*",
    "*://*.coupangplay.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.netflix.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.coupangplay.com/*"],
      "js": ["vtt-parser.js", "ttml-parser.js", "subtitle-session.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.netflix.com/*"],
      "js": ["vtt-parser.js", "ttml-parser.js", "subtitle-session.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
