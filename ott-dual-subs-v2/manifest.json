{
  "manifest_version": 3,
  "name": "OTT 이중자막 (Dual Subs)",
  "version": "2.1.1",
  "description": "쿠팡플레이·넷플릭스 이중자막과 자막 옆 동시 표현 주석. 선택적 AI 자동 주석은 별도 연결과 동의가 필요합니다.",
  "permissions": [
    "webRequest",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://*.coupangstreaming.com/*",
    "*://*.coupangplay.com/*",
    "*://*.nflxvideo.net/*",
    "*://*.netflix.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.coupangplay.com/*"
      ],
      "js": [
        "vtt-parser.js",
        "ttml-parser.js",
        "subtitle-session.js",
        "study.js",
        "annotations.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "vtt-parser.js",
        "ttml-parser.js",
        "subtitle-session.js",
        "study.js",
        "annotations.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "optional_host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "options_ui": {
    "page": "study-options.html",
    "open_in_tab": true
  }
}
